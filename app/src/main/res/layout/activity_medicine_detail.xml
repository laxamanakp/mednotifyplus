<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:spacing="12dp">

        <!-- CardView for visual grouping -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            android:padding="16dp"
            android:backgroundTint="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:divider="?android:attr/dividerHorizontal"
                android:showDividers="middle"
                android:dividerPadding="8dp">

                <TextView
                    android:id="@+id/textDetailName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold"
                    android:paddingBottom="6dp" />

                <TextView
                    android:id="@+id/textDetailType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Type"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/textDetailPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Price This Year"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/textDetailPriceLastYear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Price Last Year"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/textDetailCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingVertical="4dp" />

                <TextView
                    android:id="@+id/textDetailInstructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Instructions"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/textDetailReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reference"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />

                <TextView
                    android:id="@+id/textDetailMaxIntake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Max Intake Before Consult"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
